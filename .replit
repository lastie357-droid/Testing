modules = ["java-graalvm22.3", "nodejs-20", "web", "bash", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["netcat-gnu"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 6000
externalPort = 6000

[[ports]]
localPort = 6009
externalPort = 3001

[[ports]]
localPort = 7000
externalPort = 3000

[[ports]]
localPort = 7500
externalPort = 80
exposeLocalhost = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Device Simulator"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "APK Build"

[[workflows.workflow]]
name = "Backend Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm install --prefer-offline && npm run build && node server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "APK Build"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Apk-builder && BUILD_URL=\"http://localhost:5000\" BUILD_API_KEY=\"${BUILD_API_KEY:-${BUILD_API:-$BUILD_WORKER_API}}\" bash build.sh --worker"

[userenv]

[userenv.shared]
BUILD_WORKER_API_KEY = "yYKcwbqMc2eBiYu70aNKY0qC4MXv3ZHwKolgYeEze3UMZj-N"
PUBLIC_URL = "https://15e5e7d5-e42c-4985-82e6-0ec651dba38d-00-3lfg8plmgm3u9.worf.replit.dev"
APK_GITHUB_REPO = "lastie357-droid/Apk-builder"
